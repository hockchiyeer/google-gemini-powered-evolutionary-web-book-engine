{
  "name": "google-gemini-powered-evolutionary-web-book-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:test": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "start": "tsx server/server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "package:aistudio": "node scripts/package-google-ai-studio.mjs",
    "test": "node tests/scripts/run-local-cypress.cjs",
    "test:e2e": "node tests/scripts/run-cypress-with-reports.cjs",
    "test:server": "tsx tests/server/documentTitle.test.ts && tsx tests/server/evolutionService.test.ts && tsx tests/server/googleSearchFallback.test.ts && tsx tests/server/hyperlinkExport.test.ts && tsx tests/server/googleSearchFallbackClient.test.ts && tsx tests/server/fallbackNotice.test.ts && tsx tests/server/cjkPagination.test.ts",
    "cy:run": "cypress run --config-file tests/cypress.config.cjs",
    "cy:run:local": "node tests/scripts/run-cypress-with-reports.cjs",
    "cy:open": "cypress open --config-file tests/cypress.config.cjs",
    "report:generate": "node tests/scripts/generate-cucumber-report.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cypress": "^16.2.0",
    "cypress-multi-reporters": "^2.0.5",
    "cypress-xpath": "^2.0.1",
    "esbuild": "^0.28.2",
    "mocha-junit-reporter": "^2.2.1",
    "mochawesome": "^8.1.1",
    "multiple-cucumber-html-reporter": "^4.5.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
